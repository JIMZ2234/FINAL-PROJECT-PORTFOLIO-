
{
  "name": "Laravel PHP 8.4 + PostgreSQL",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "root",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Laravel Website",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "onecentlin.laravel-blade",
        "xdebug.php-debug"
      ]
    }
  }
}
